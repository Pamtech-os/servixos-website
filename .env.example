# Public site URL used for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://servixos.com

# Base URL of the ServixOS backend API (no trailing slash). The waitlist form
# posts to `${NEXT_PUBLIC_API_BASE_URL}/api/waitlist` from the browser.
NEXT_PUBLIC_API_BASE_URL=

# Meta Pixel ID. Set this in production only; the pixel doesn't load when empty.
NEXT_PUBLIC_META_PIXEL_ID=2406910840137147
